#!/usr/bin/env bash
set -euo pipefail

ENTRIES_DIR="/boot/loader/entries"
CONFIG="root"

# Opciones del kernel (edítalas si quieres)
OPTIONS="rw zswap.enabled=0 rootfstype=btrfs loglevel=3 quiet splash"

# Detectar UUID automáticamente
UUID=$(findmnt -no UUID /)

# Detectar TODOS los kernels instalados (no solo el primero que encuentre).
# Así, si tenés varios (linux, linux-zen, linux-cachyos, etc.) o cambiás de
# uno a otro, las entradas de snapshot siguen funcionando para todos.
mapfile -t KERNELS < <(find /boot -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' | sort)

if [[ ${#KERNELS[@]} -eq 0 ]]; then
    echo "❌ No se encontró ningún kernel (vmlinuz-*) en /boot" >&2
    exit 1
fi

# Detectar microcódigo
MICROCODE=""
if [[ -f /boot/intel-ucode.img ]]; then
    MICROCODE="intel-ucode.img"
elif [[ -f /boot/amd-ucode.img ]]; then
    MICROCODE="amd-ucode.img"
fi

# Limpiar entradas antiguas
rm -f "${ENTRIES_DIR}"/snapshot-*.conf

# Últimos 5 snapshots (excluyendo el #0 "current", que no es un snapshot real)
mapfile -t SNAPSHOTS < <(
    snapper -c "$CONFIG" list |
    awk '/^[[:space:]]*[0-9]+/ {print $1}' |
    awk '$1 != 0' |
    tail -5
)

for NUM in "${SNAPSHOTS[@]}"; do
    SNAP_PATH="@/.snapshots/${NUM}/snapshot"

    for KERNEL in "${KERNELS[@]}"; do
        SUFFIX="${KERNEL#vmlinuz-}"
        INITRAMFS="initramfs-${SUFFIX}.img"

        # Si a este kernel le falta el initramfs, lo saltamos (evita entradas rotas)
        if [[ ! -f "/boot/${INITRAMFS}" ]]; then
            echo "⚠️  Salteando ${KERNEL}: no existe /boot/${INITRAMFS}" >&2
            continue
        fi

        {
            echo "title   CachyOS Snapshot #${NUM} (${SUFFIX})"
            echo "linux   /${KERNEL}"

            [[ -n "$MICROCODE" ]] && echo "initrd  /${MICROCODE}"

            echo "initrd  /${INITRAMFS}"
            echo "options root=UUID=${UUID} rootflags=subvol=${SNAP_PATH} ${OPTIONS}"
            echo "sort-key b-snapshot-${NUM}-${SUFFIX}"
        } > "${ENTRIES_DIR}/snapshot-${NUM}-${SUFFIX}.conf"
    done
done

echo
echo "Kernels detectados: ${KERNELS[*]}"
echo "Entradas creadas:"
ls "${ENTRIES_DIR}"/snapshot-*.conf
